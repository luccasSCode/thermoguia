# Copie para .env e ajuste.
PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=thermoguia
DB_USER=thermoguia
DB_PASSWORD=thermoguia

# Gere com: openssl rand -hex 32
JWT_SECRET=troque-este-segredo-em-producao

# IA (opcional). Sem chave, o assistente responde com o motor de regras local.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Verificação das fotos da Comunidade (hidratação, boné, protetor...).
# Sem chave, as fotos vão para a revisão humana (rotas /admin).
ANTHROPIC_VISION_MODEL=claude-opus-5-5

# Chave da fila de revisão humana (/admin). Gere com: openssl rand -hex 24
ADMIN_TOKEN=

# Limite diário de perguntas ao assistente no plano gratuito.
FREE_AI_DAILY_LIMIT=15

# Serviços de mapa. Os servidores públicos são para desenvolvimento;
# em produção, hospede seu próprio OSRM/Nominatim (ver docs/ARQUITETURA.md).
ROUTING_FOOT_URL=https://routing.openstreetmap.de/routed-foot
ROUTING_BIKE_URL=https://routing.openstreetmap.de/routed-bike
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
CACHE_DIR=cache
CONTACT_EMAIL=contato@thermoguia.app
